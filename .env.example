# ── Brain + ears (one Groq key covers both) ────────────────────────────────
# https://console.groq.com/keys — free, no card
GROQ_API_KEY=

# Optional second brain: when Groq's 200k tokens/day runs out, Gemini takes over.
# Free, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any OpenAI-compatible endpoint works: Cerebras, OpenRouter, Together, Ollama…
# LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3-turbo

# ── Voice (Azure Speech — free F0: 500k chars/month) ───────────────────────
# https://portal.azure.com → "Speech" resource → Keys and endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
TTS_VOICE_UR=ur-PK-UzmaNeural
TTS_VOICE_EN=en-US-JennyNeural
TTS_VOICE_PS=ps-AF-LatifaNeural

# Keyless demo voice (Google's read-aloud endpoint, Urdu + English).
# Lets the widget speak before any account exists. Set to off for production.
DEMO_TTS=on

# ── Optional: better-sounding Urdu/Pashto, 10k chars/month free ────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_v3
# Free plan is ~10k characters/month. 320/day spreads it across the whole month.
ELEVENLABS_DAILY_CHARS=320
# auto = Azure if its key exists, else ElevenLabs, else the keyless demo voice.
# Force ElevenLabs for a client demo with: TTS_PROVIDER=elevenlabs
TTS_PROVIDER=auto

# ── Bookings ───────────────────────────────────────────────────────────────
# Persist to a JSON file locally; leave blank for in-memory (demo only).
BOOKINGS_FILE=.data/bookings.json
# Production: Supabase (see README for the table SQL)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# ── Tell the clinic instantly (WhatsApp Cloud API, 1000 free conv/month) ───
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# CLINIC_WHATSAPP_TO=923123329479

# ── CORS: the site that embeds the widget ──────────────────────────────────
# ALLOWED_ORIGINS=https://tanveerkhokar.vercel.app

# Password for /admin (bookings list). Change before handing to the clinic.
ADMIN_KEY=tkdent-demo
